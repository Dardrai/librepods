<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/popup_shape" android:fillViewport="false" android:forceDarkAllowed="false"
    android:overScrollMode="never" android:scrollbars="none">
    <LinearLayout android:id="@+id/linear_layout"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp">
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="44dp" android:layout_gravity="center" android:gravity="center"
                android:fontFamily="@font/inter" android:textSize="24sp" android:textColor="#18181B"
                android:maxLines="2" android:ellipsize="end" />
            <ImageButton android:id="@+id/close_button" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="end|top" android:padding="16dp" android:src="@drawable/close"
                android:background="@drawable/popup_button_shape"
                android:contentDescription="@string/pairing_close" />
        </FrameLayout>
        <FrameLayout android:id="@+id/popup_artwork_container" android:layout_width="match_parent" android:layout_height="140dp"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
            android:importantForAccessibility="noHideDescendants">
            <TextureView android:id="@+id/popup_video" android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone" />
            <ImageView android:id="@+id/popup_artwork" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/pairing_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center" android:fontFamily="@font/inter"
            android:textSize="14sp" android:textColor="#636366" android:accessibilityLiveRegion="polite" />
        <FrameLayout android:id="@+id/pairing_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginTop="12dp">
            <Button android:id="@+id/pairing_primary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                android:background="@drawable/pairing_primary_background" android:backgroundTint="#0066D6"
                android:stateListAnimator="@null" android:textColor="#FFFFFF" android:textSize="16sp"
                android:fontFamily="@font/inter" android:textAllCaps="false" android:text="@string/pairing_connect" />
            <ProgressBar android:id="@+id/pairing_progress" style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
