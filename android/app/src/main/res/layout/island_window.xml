<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_window_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/island_capsule_background"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="156dp"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="20dp"
    android:importantForAccessibility="yes"
    android:accessibilityLiveRegion="polite">

    <LinearLayout
        android:id="@+id/island_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/island_artwork"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="12dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/island_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/island_connected_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/sf_pro"
                android:textColor="#A1A1A6"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/island_action_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ic_undo_button_bg"
            android:contentDescription="@string/undo"
            android:src="@drawable/ic_undo"
            android:scaleType="centerInside"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/island_battery_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/island_left_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:importantForAccessibility="noHideDescendants">
            <me.kavishdevar.librepods.presentation.overlays.IslandBatteryRingView
                android:id="@+id/island_left_ring"
                android:layout_width="30dp"
                android:layout_height="30dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
                <TextView android:id="@+id/island_left_value" style="@style/IslandBatteryValue" />
                <TextView android:id="@+id/island_left_label" style="@style/IslandBatteryLabel" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/island_right_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:importantForAccessibility="noHideDescendants">
            <me.kavishdevar.librepods.presentation.overlays.IslandBatteryRingView
                android:id="@+id/island_right_ring"
                android:layout_width="30dp"
                android:layout_height="30dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
                <TextView android:id="@+id/island_right_value" style="@style/IslandBatteryValue" />
                <TextView android:id="@+id/island_right_label" style="@style/IslandBatteryLabel" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/island_case_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:importantForAccessibility="noHideDescendants">
            <me.kavishdevar.librepods.presentation.overlays.IslandBatteryRingView
                android:id="@+id/island_case_ring"
                android:layout_width="30dp"
                android:layout_height="30dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
                <TextView android:id="@+id/island_case_value" style="@style/IslandBatteryValue" />
                <TextView android:id="@+id/island_case_label" style="@style/IslandBatteryLabel" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
