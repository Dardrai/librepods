include_guard(GLOBAL)

function(eld_add_private_owned_fdk)
    if(TARGET fdk-aac OR TARGET eld_owned_fdk)
        message(FATAL_ERROR "The private owned encoder must build its own pinned FDK target")
    endif()
    set(FDK_REVISION cac04476081a23c870fed05c36228cd02c5e7c3d)
    set(FDK_SOURCE_SHA256 1b572fcb5e2a81aa0447a92ca95bfe4979f3edfc09918e0627b726bcd0165ff1)
    set(LIBREPODS_FDK_ARCHIVE "" CACHE FILEPATH "Optional offline copy of the pinned private FDK source archive")
    if(LIBREPODS_FDK_ARCHIVE)
        if(NOT EXISTS "${LIBREPODS_FDK_ARCHIVE}" OR IS_DIRECTORY "${LIBREPODS_FDK_ARCHIVE}")
            message(FATAL_ERROR "LIBREPODS_FDK_ARCHIVE must name the pinned source archive file")
        endif()
        file(SHA256 "${LIBREPODS_FDK_ARCHIVE}" FDK_ARCHIVE_SHA256)
        if(NOT FDK_ARCHIVE_SHA256 STREQUAL FDK_SOURCE_SHA256)
            message(FATAL_ERROR "FDK source archive SHA-256 mismatch")
        endif()
        set(FDK_SOURCE_URL "${LIBREPODS_FDK_ARCHIVE}")
    else()
        set(FDK_SOURCE_URL "https://codeload.github.com/mstorsjo/fdk-aac/zip/${FDK_REVISION}")
    endif()
    # Keep upstream options local to this function rather than changing the app's cache.
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_PROGRAMS OFF)
    set(FDK_AAC_INSTALL_CMAKE_CONFIG_MODULE OFF)
    set(FDK_AAC_INSTALL_PKGCONFIG_MODULE OFF)
    include(FetchContent)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    FetchContent_Declare(librepods_owned_fdk
        URL "${FDK_SOURCE_URL}" URL_HASH "SHA256=${FDK_SOURCE_SHA256}")
    FetchContent_MakeAvailable(librepods_owned_fdk)
    get_target_property(FDK_TARGET_TYPE fdk-aac TYPE)
    if(NOT FDK_TARGET_TYPE STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "The private owned FDK target must remain static and hidden")
    endif()
    set_target_properties(fdk-aac PROPERTIES POSITION_INDEPENDENT_CODE ON
        C_VISIBILITY_PRESET hidden CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON
        CXX_STANDARD 17 CXX_STANDARD_REQUIRED ON)
    set(ELD_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    set(OWNED_TEST_ROOT "${ELD_ROOT}/../../../../../tools/native-owned-fdk-tests")
    if(ANDROID)
        target_include_directories(fdk-aac PRIVATE "${OWNED_TEST_ROOT}/compat")
    endif()
    add_library(eld_owned_fdk STATIC "${ELD_ROOT}/owned_fdk_encoder.cpp")
    target_include_directories(eld_owned_fdk PUBLIC "${ELD_ROOT}")
    target_link_libraries(eld_owned_fdk PRIVATE fdk-aac)
    set_target_properties(eld_owned_fdk PROPERTIES POSITION_INDEPENDENT_CODE ON
        CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
    if(ANDROID)
        target_link_libraries(eld_owned_fdk PUBLIC log)
    endif()
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/licenses")
    configure_file("${librepods_owned_fdk_SOURCE_DIR}/NOTICE" "${CMAKE_BINARY_DIR}/licenses/NOTICE-FDK.txt" COPYONLY)
    configure_file("${OWNED_TEST_ROOT}/LICENSE" "${CMAKE_BINARY_DIR}/licenses/NOTICE-owned-fdk-MIT.txt" COPYONLY)
endfunction()
